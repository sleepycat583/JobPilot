APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL production example: postgresql+psycopg://user:password@db:5432/career
UPLOAD_DIR=./data/uploads
# Use s3 for shared object storage in multi-instance deployments.
UPLOAD_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=career-agent
FRONTEND_ORIGIN=http://127.0.0.1:5173
SSE_HEARTBEAT_SECONDS=15
MOCK_TASK_DELAY_SECONDS=0.15
JOB_LEASE_SECONDS=900
GRAPH_CHECKPOINT_PATH=./data/langgraph.db
# Keep sqlite for local/single-instance deployment. Postgres requires the URL below.
CHECKPOINT_BACKEND=sqlite
GRAPH_CHECKPOINT_DATABASE_URL=
AUTO_CREATE_CHECKPOINT_SCHEMA=false
CHROMA_PERSIST_DIRECTORY=./data/chroma
# Use http for a shared Chroma service in multi-instance deployments.
CHROMA_BACKEND=local
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_API_KEY=
CHROMA_COLLECTION_NAME=career_resume_chunks
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# Stub mode runs the real LangGraph topology without semantic inference.
# Switch to openai only after authenticating. Prefer LangSmith OAuth for tracing.
LLM_MODE=stub
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=career-agent-workbench
LANGSMITH_API_KEY=

# Never commit real credentials. This file contains names and empty placeholders only.
