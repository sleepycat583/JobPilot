# 首次本地启动的最小配置：复制为 backend/.env 后可直接使用 Stub 模式。
# 不要把真实 API Key 写入仓库、日志、截图或 commit 信息。
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# 个人电脑单机默认使用 SQLite；PostgreSQL 仅用于未来共享部署，不需要填写。
# PostgreSQL production example: postgresql+psycopg://user:password@db:5432/career
UPLOAD_DIR=./data/uploads
# 单机使用 local；S3/MinIO 仅用于多实例共享对象存储。
UPLOAD_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=career-agent
FRONTEND_ORIGIN=http://127.0.0.1:5173
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_REPLAY_BATCH_SIZE=100
LOCAL_HISTORY_RETENTION_DAYS=30
MOCK_TASK_DELAY_SECONDS=0.15
JOB_LEASE_SECONDS=900
GRAPH_CHECKPOINT_PATH=./data/langgraph.db
# 单机保持 sqlite；只有共享部署才切换为 postgres 并填写下面的 URL。
CHECKPOINT_BACKEND=sqlite
GRAPH_CHECKPOINT_DATABASE_URL=
AUTO_CREATE_CHECKPOINT_SCHEMA=false
CHROMA_PERSIST_DIRECTORY=./data/chroma
# 单机使用 local；HTTP Chroma 仅用于多实例共享向量库。
CHROMA_BACKEND=local
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_API_KEY=
CHROMA_COLLECTION_NAME=career_resume_chunks
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# Stub 模式会运行完整 LangGraph 拓扑，但不调用第三方模型，首次启动无需密钥。
# 需要真实模型时才切换为 openai，并填写 OPENAI_BASE_URL（如需要）和 OPENAI_API_KEY。
# LangSmith 优先使用本机 OAuth；LANGSMITH_API_KEY 不要写入 Git 或日志。
LLM_MODE=stub
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=career-agent-workbench
LANGSMITH_API_KEY=

# Never commit real credentials. This file contains names and empty placeholders only.
