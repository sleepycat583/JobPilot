# ============================================================
# career-agent-workbench — .gitignore
# ============================================================

# ── 敏感配置（绝不提交真实密钥）──────────────────────────────
# .env.* 覆盖所有变体（.env.local / .env.production 等）
# !.env.example 显式豁免模板文件，确保它可以提交
.env
.env.*
!.env.example

# ── 依赖目录 ─────────────────────────────────────────────────
node_modules/
backend/.venv/

# ── 前端构建产物 ──────────────────────────────────────────────
dist/
.vite/
frontend/output/

# ── 后端运行时数据（SQLite 数据库、上传文件、WAL 日志）────────
# data/ 下的所有内容都是运行时生成的，不应入库
backend/data/
# 防御性规则：即使 data 路径变化，SQLite 相关文件也不入库
*.db
*.db-shm
*.db-wal

# ── Python 缓存与测试产物 ──────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ── 日志 ──────────────────────────────────────────────────────
*.log
logs/

# ── 操作系统垃圾文件 ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE 配置 ──────────────────────────────────────────────────
.vscode/
.idea/
