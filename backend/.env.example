APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
FRONTEND_ORIGIN=http://127.0.0.1:5173
SSE_HEARTBEAT_SECONDS=15
MOCK_TASK_DELAY_SECONDS=0.15
GRAPH_CHECKPOINT_PATH=./data/langgraph.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=career_resume_chunks
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# Stub mode runs the real LangGraph topology without semantic inference.
# Switch to openai only after authenticating. Prefer LangSmith OAuth for tracing.
LLM_MODE=stub
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=career-agent-workbench
LANGSMITH_API_KEY=

# Never commit real credentials. This file contains names and empty placeholders only.
